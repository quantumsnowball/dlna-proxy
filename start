#!/bin/bash

# before use, try to stop all existing server
killall -q -v -w nginx
killall -q -v -w rclone
killall -q -v -w python


# start nginx reverse proxy server
nginx -c ~/dlna-proxy/nginx.conf
if [ $? -eq 0 ]; then
  printf "\nProxy server started\n"
else
  printf "\nFAILED: Failed to start reverse proxy server\n"
fi


# start a python ssdp server
python ~/dlna-proxy/ssdp.py 192.168.1.100 7879 &
SSDP_PID=$1
printf "\nPython SSDP server started\n"

# start rclone dlna server
rclone serve dlna --name DLNA --addr localhost:7879 qsc-r:DLNA &
RCLONE_PID=$!
printf "\nRclone server started\n"

# wait for the rclone serve and python ssdp process to be interrupted (Ctrl+C)
wait $RCLONE_PID 
wait $SSDP_PID

# after use, try to stop all existing server
if nginx -s stop 2>/dev/null; then
  printf "\nProxy server stopped\n\n"
fi
killall -q -v -w nginx
killall -q -v -w rclone
